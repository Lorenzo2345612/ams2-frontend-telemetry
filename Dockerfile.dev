FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY package*.json ./
RUN npm install

# Copy config files (source will be mounted as volume)
COPY vite.config.ts tsconfig.json tsconfig.node.json postcss.config.js tailwind.config.js index.html ./

ENV VITE_API_URL=http://api:8000

EXPOSE 3000

CMD ["npm", "run", "dev"]
